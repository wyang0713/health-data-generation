# Copy this file to .env (same folder as docker-compose.yml) and fill in values.
# Used by both the postgres and python services.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=health_db

# Hostname of the Postgres server. Defaults to "postgres" (the docker-compose
# service name) if unset; set to "localhost" when running etl.py outside Docker.
# POSTGRES_HOST=postgres
